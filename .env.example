# Copy to .env and fill in. The server loads this file from the repo root at
# startup. .env is gitignored — never commit real credentials.
#
# Every variable below is OPTIONAL. With none of them set, the server still
# starts and every deterministic scoring, ranking, reconciliation, and preview
# tool works. Credentials only unlock the n8n and paid-enrichment tiers.

# --- n8n operations ------------------------------------------------------
# Base URL of your n8n instance.
N8N_BASE_URL=http://127.0.0.1:5678

# Scoped n8n API key. Without it, every n8n tool refuses to run.
N8N_API_KEY=

# Comma-separated workflow IDs the connector may inspect or retry.
# This is the safety allowlist: with it empty, retries are DISABLED entirely
# and listing falls back to unfiltered read-only access.
N8N_APPROVED_WORKFLOW_IDS=

# --- Contact resolution (all optional, all cost-bearing) -----------------
# Hunter.io key for tier-3 email verification. Consumes paid credits.
EMAIL_VERIFY_KEY=

# People Data Labs key for tier-4 enrichment. Consumes paid credits.
PEOPLEDATALABS_API_KEY=

# GitHub token for tier-1 commit-email harvesting. Without it, tier 1 is
# skipped and resolution degrades to pattern inference.
GITHUB_TOKEN=

# Domain used as HELO/MAIL FROM identity for SMTP probes. Set this to a domain
# you actually control — receiving mail servers log the probe.
SMTP_PROBE_DOMAIN=example.com

# --- Paths (normally set automatically by .mcp.json) ---------------------
# CONTACT_TIERS_PATH=/path/to/plugin/servers
# CLAY_FUNCTION_POLICY_PATH=/path/to/plugin/config/clay-functions.json
