{
  "mcpServers": {
    "clay": {
      "type": "http",
      "url": "https://api.clay.com/v3/mcp"
    },
    "crm": {
      "type": "http",
      "url": "${user_config.crm_mcp_url}"
    },
    "gtm": {
      "command": "/bin/bash",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run-gtm-server.sh"],
      "env": {
        "CONTACT_TIERS_PATH": "${CLAUDE_PLUGIN_ROOT}/servers",
        "CLAY_FUNCTION_POLICY_PATH": "${CLAUDE_PLUGIN_ROOT}/config/clay-functions.json",
        "N8N_BASE_URL": "${user_config.n8n_base_url}"
      }
    }
  }
}
