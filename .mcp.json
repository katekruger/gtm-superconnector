    },
    "crm": {
      "type": "http",
      "url": "https://crm.example.com/api/mcp"
    },
    "gtm": {
      "command": "/bin/bash",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run-gtm-server.sh"],
